// ===========================
// VARIABLES + EMIT
// ===========================
bind name = "Vivaan"
bind age = 21
bind number = 5

emit name
emit age
emit number

// ===========================
// SIMPLE REPEAT
// ===========================
repeat 3:
    emit "Hello!"

// ===========================
// REPEAT WITH LOOP VARIABLE
// ===========================
repeat x in number:
    emit x

// ===========================
// NESTED LOOPS
// ===========================
repeat 2:
    emit "Outer loop"
    repeat y in 3:
        emit "  Inner loop value:"
        emit y

// ===========================
// IF / ORIF / ELSE
// ===========================
if age > 20:
    emit "old"
orif age > 10:
    emit "teen"
else:
    emit "young"

// Another test with exact edge
bind test_value = 1
if test_value > 20:
    emit "too big"
orif test_value == 10:
    emit "exact match"
else:
    emit "other"